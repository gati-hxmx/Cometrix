# --- データベース (docker-compose.yml の db サービスと合わせる) ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=cometrix
DB_PASSWORD=
DB_NAME=cometrix

# --- Flask セッション用シークレットキー (ランダムな文字列を生成して設定) ---
FLASK_SECRET_KEY=

# --- Google OAuth (Google Cloud Console > APIとサービス > 認証情報) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ローカル開発専用: http(非TLS)でのOAuthコールバックをoauthlibに許可する設定。
# 本番(https運用)環境では絶対に設定しないこと。
OAUTHLIB_INSECURE_TRANSPORT=1

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Twitch (https://dev.twitch.tv/console/apps) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Celery ワーカーをDB無効モードで動かす場合のみ 1 を設定 ---
CELERY_MODE=
